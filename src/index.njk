---
layout: layouts/base.njk
title: Home
---

{% set featuredArtist = collections.featuredArtists[0] %}

<section class="hero">
  <div class="wrapper hero-grid">
    <div class="hero-copy">
      <h1>Come draw with us.</h1>
      <p class="lede">A queer figure drawing group in Seattle with no pressure and no judgment. Bring a friend or make a new one here. ☺︎</p>
      <div class="hero-actions">
        <a class="button" href="{{ site.nextEventUrl }}" target="_blank" rel="noreferrer">RSVP</a>
        <a class="button ghost" href="{{ site.signupUrl }}" target="_blank" rel="noreferrer">Get updates</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/assets/images/hero.jpeg" alt="Artists drawing together at Figure It Out." loading="eager"/>
    </div>
  </div>
</section>
<section class="next-event" id="next-event">
  <div class="wrapper">
    <h2>Next event</h2>
    <div class="event-card">
      <h3 class="event-title">Figure It Out with Esteban</h3>
      <div class="event-card-body">
        <div class="event-details">
          <p>
            <strong>Date:</strong>
            Tuesday, October 13, 2026</p>
          <p>
            <strong>Time:</strong>
            Social at 6pm. Drawing at 7pm.</p>
          <p>
            <strong>Location:</strong>
            Vermillion, 1501 11th Ave, Seattle, WA 98122</p>
          <p>
            <strong>Cost:</strong>
            $15</p>
          <p>
            <strong>Model:</strong>
            Esteban</p>
          <div class="event-notes">
            <p>All skill levels are welcome; no experience is required.</p>
            <p>Net proceeds benefit Trans Lifeline.</p>
            <ul>
              <li>Bring your own drawing materials.</li>
            </ul>
            <p>No photos of the model; photos of artwork are welcome.</p>
          </div>
          <a class="button" href="{{ site.nextEventUrl }}" target="_blank" rel="noreferrer">RSVP / Sign up</a>
        </div>
        <div class="event-media">
          <img src="/assets/images/2026-10-13_esteban.png" alt="Poster for Figure It Out with Esteban on October 13, 2026." loading="lazy"/>
        </div>
      </div>
    </div>
  </div>
</section>
{% if featuredArtist %}
  {% set artist = featuredArtist %}
  {% set artistHeaderContent = featuredArtist.templateContent | artistHeaderContent %}
  {% set showReadMore = true %}
  {% set portraitLoading = "lazy" %}
  <section class="next-event featured-artist-preview" id="featured-artist">
    <div class="wrapper">
      <h2>Featured artist</h2>
      {% include "partials/artist-header-card.njk" %}
    </div>
  </section>
{% endif %}
